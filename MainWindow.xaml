<Window x:Class="LindenCafe_BalsecenAda_KasperJamie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LindenCafe_BalsecenAda_KasperJamie"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Canvas Background="DarkGreen">
            <Label x:Name="LabelLindenCafe" Content="Linden Cafe" Foreground="White" FontSize="40" Canvas.Left="291" Canvas.Top="28"/>
            <Button x:Name="ButtonGameContinue" Content="Spiel fortsetzen" FontSize="30" Foreground="White" Canvas.Left="36" Canvas.Top="116" Background="DarkSlateGray" Height="60" Width="700" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ButtonGameContinue_Click"/>
            <Button x:Name="ButtonNewGame" Content="Neues Spiel" FontSize="30" Foreground="White" Canvas.Left="36" Canvas.Top="217" Background="DarkSlateGray" Height="60" Width="700" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ButtonNewGame_Click"/>
            <Button x:Name="ButtonUpdates" Content="Updates" FontSize="30" Foreground="White" Canvas.Left="36" Canvas.Top="320" Background="DarkSlateGray" Height="60" Width="700" HorizontalAlignment="Center" VerticalAlignment="Top" Click="ButtonUpdates_Click"/>


        </Canvas>

    </Grid>
</Window>
